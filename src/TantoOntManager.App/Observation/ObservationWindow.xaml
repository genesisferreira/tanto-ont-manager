<Window x:Class="TantoOntManager.App.Observation.ObservationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Observar navegação GET e mapear gravação WAN/PPPoE — bloqueado"
        Height="860"
        Width="1360"
        MinHeight="640"
        MinWidth="960"
        Background="#121212"
        WindowStartupLocation="CenterOwner">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#161616" Padding="16,12" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1">
      <StackPanel>
        <TextBlock Text="A solicitação será capturada e bloqueada; nada será enviado à ONT." Foreground="#F5C400" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="Observação passiva — o operador navega na interface oficial da ONT. A ferramenta não clica, não preenche campos e não executa scripts inventados." Foreground="#A8A8A8" Margin="0,6,0,0" TextWrapping="Wrap" />
        <TextBlock x:Name="StatusText" Text="Carregando WebView2 isolado…" Foreground="#A8A8A8" Margin="0,6,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Right" Width="400" Background="#242424" Padding="12" BorderBrush="#3A3A3A" BorderThickness="1,0,0,0">
      <DockPanel>
        <ScrollViewer DockPanel.Dock="Top" MaxHeight="560" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Captura por tela (20 s)" Foreground="#F5C400" FontWeight="SemiBold" Margin="0,0,0,8" />
            <Button Content="Observar Device" Click="OnDevice" Margin="0,0,0,6" />
            <Button Content="Observar PON" Click="OnPon" Margin="0,0,0,6" />
            <Button Content="Observar WAN Status" Click="OnWanStatus" Margin="0,0,0,6" />
            <Button Content="Observar WAN Config" Click="OnWanConfig" Margin="0,0,0,6" />
            <Button Content="Fechar baseline do shell" Click="OnCloseBaseline" Style="{StaticResource SecondaryButton}" Margin="0,0,0,12" />
            <TextBlock Text="Mapear gravação WAN/PPPoE — bloqueado" Foreground="#F5C400" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBlock Text="Digite exatamente MAPEAR F6201B" Foreground="#A8A8A8" FontSize="11" Margin="0,0,0,4" />
            <TextBox x:Name="ConfirmationBox" Margin="0,0,0,8" />
            <Button x:Name="StartWriteCaptureButton" Content="Iniciar captura bloqueada" Click="OnStartWriteCapture" Margin="0,0,0,6" />
            <Button Content="Cancelar captura" Click="OnCancelWriteCapture" Style="{StaticResource SecondaryButton}" Margin="0,0,0,6" />
            <Button Content="Exportar proposta sanitizada" Click="OnExportWriteContract" Margin="0,0,0,6" />
            <Button x:Name="PromoteWriteButton" Content="Promover contrato de gravação" Click="OnPromoteWriteContract" Style="{StaticResource SecondaryButton}" Margin="0,0,0,6" />
            <TextBlock x:Name="PromotionReasonText" Foreground="#A8A8A8" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
            <Button Content="Inspecionar estrutura do DOM" Click="OnInspectDom" Margin="0,0,0,6" />
            <Button Content="Exportar diagnóstico de capacidade" Click="OnExportWriteCapability" Margin="0,0,0,6" />
            <Button Content="Fechar observador" Click="OnCloseObserver" Style="{StaticResource SecondaryButton}" Margin="0,0,0,12" />
            <TextBlock Text="Contadores" Foreground="#F5C400" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock x:Name="CountersText" Foreground="#F3F3F3" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
            <Button Content="Cancelar observação" Click="OnCancel" Style="{StaticResource SecondaryButton}" Margin="0,12,0,0" />
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer Margin="0,12,0,0">
          <TextBlock x:Name="TableText" Foreground="#F3F3F3" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
        </ScrollViewer>
      </DockPanel>
    </Border>
    <wv2:WebView2 x:Name="WebView" />
  </DockPanel>
</Window>
