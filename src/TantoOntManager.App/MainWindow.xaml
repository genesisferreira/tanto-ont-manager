<Window x:Class="TantoOntManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tanto ONT Manager"
        Height="860"
        Width="1180"
        MinHeight="720"
        MinWidth="980"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#161616" Padding="20,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding ProductName}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
          <TextBlock Text="Tanto Telecom · ferramenta interna de bancada" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="#2A2400" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,12,0">
            <TextBlock Text="{Binding ModeLabel}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
          </Border>
          <TextBlock Text="{Binding VersionLabel}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="#161616" Padding="20,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Última operação" Foreground="{StaticResource MutedBrush}" FontSize="11" />
          <TextBlock Text="{Binding LastOperation}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Text="Tempo" Foreground="{StaticResource MutedBrush}" FontSize="11" />
          <TextBlock Text="{Binding LastDuration}" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Log sanitizado" Foreground="{StaticResource MutedBrush}" FontSize="11" />
          <TextBlock Text="{Binding LogPath}" TextWrapping="Wrap" FontSize="11" />
        </StackPanel>
        <Border Grid.Column="3" Background="#2A2400" CornerRadius="4" Padding="12,8">
          <TextBlock Text="{Binding StatusLabel}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
        </Border>
      </Grid>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.1*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="1.4*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="16" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="Conexão" />
            <TextBlock Text="Interface Ethernet" Foreground="{StaticResource MutedBrush}" />
            <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}" DisplayMemberPath="Name" Margin="0,4,0,10" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Estado do cabo" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Text="{Binding LinkState}" FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="IPv4 atual" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Text="{Binding CurrentIpv4}" FontWeight="SemiBold" />
              </StackPanel>
            </Grid>
            <TextBlock Text="IP esperado da ONT" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" />
            <ComboBox ItemsSource="{Binding KnownIpOptions}" SelectedItem="{Binding SelectedKnownIp}" Margin="0,4,0,8" />
            <TextBox Text="{Binding CustomIp, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{Binding IsCustomIp, Converter={StaticResource BoolToVis}}"
                     Margin="0,0,0,8" />
            <TextBlock Text="{Binding ExpectedOntIp}" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12" />
            <CheckBox IsChecked="{Binding TrustLocalCertificate}" Content="Confiar no certificado HTTPS local somente deste IP" Margin="0,0,0,8" />
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,12"
                       Text="Aviso: o certificado da ONT é self-signed. A confiança não é global e vale só para o endereço selecionado." />
            <StackPanel Orientation="Horizontal">
              <Button Content="Detectar ONT" Command="{Binding DetectCommand}" Margin="0,0,8,0" />
              <Button Content="Testar conexão" Command="{Binding TestConnectionCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
              <Button Content="Atualizar placas" Command="{Binding RefreshAdaptersCommand}" Style="{StaticResource SecondaryButton}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="Resultado da detecção" />
            <UniformGrid Columns="2" Rows="6">
              <StackPanel Margin="0,0,12,10">
                <TextBlock Text="Fabricante" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                <TextBlock Text="{Binding Manufacturer}" FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Modelo" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                <TextBlock Text="{Binding Model}" FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel Margin="0,0,12,10">
                <TextBlock Text="Hardware" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                <TextBlock Text="{Binding Hardware}" />
              </StackPanel>
              <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Firmware" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                <TextBlock Text="{Binding Firmware}" />
              </StackPanel>
              <StackPanel Margin="0,0,12,10">
                <TextBlock Text="Boot" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                <TextBlock Text="{Binding Boot}" />
              </StackPanel>
              <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Serial (mascarado)" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                <TextBlock Text="{Binding Serial}" />
              </StackPanel>
              <StackPanel Margin="0,0,12,10">
                <TextBlock Text="MAC (mascarado)" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                <TextBlock Text="{Binding Mac}" />
              </StackPanel>
              <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Estado PON" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                <TextBlock Text="{Binding Pon}" />
              </StackPanel>
              <StackPanel Margin="0,0,12,10">
                <TextBlock Text="Temperatura" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                <TextBlock Text="{Binding Temperature}" />
              </StackPanel>
              <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Potência óptica" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                <TextBlock Text="{Binding OpticalPower}" />
              </StackPanel>
            </UniformGrid>
            <TextBlock Text="Perfis WAN encontrados" Foreground="{StaticResource MutedBrush}" FontSize="11" />
            <TextBlock Text="{Binding WanProfiles}" TextWrapping="Wrap" Margin="0,0,0,10" />
            <TextBlock Text="Capacidades detectadas" Foreground="{StaticResource MutedBrush}" FontSize="11" />
            <TextBlock Text="{Binding Capabilities}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <UniformGrid Columns="2">
              <StackPanel Margin="0,0,12,8">
                <TextBlock Text="Status HTTP/HTTPS" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                <TextBlock Text="{Binding HttpStatus}" FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel Margin="0,0,0,8">
                <TextBlock Text="Título público" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                <TextBlock Text="{Binding PublicTitle}" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Margin="0,0,12,8">
                <TextBlock Text="Tamanho da resposta" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                <TextBlock Text="{Binding ResponseSize}" />
              </StackPanel>
              <StackPanel Margin="0,0,0,8">
                <TextBlock Text="Hash curto" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                <TextBlock Text="{Binding ShortHash}" />
              </StackPanel>
            </UniformGrid>
            <TextBlock Text="Confiança da detecção" Foreground="{StaticResource MutedBrush}" FontSize="11" />
            <TextBlock Text="{Binding ConfidenceLabel}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8" />
            <TextBlock Text="Evidências encontradas" Foreground="{StaticResource MutedBrush}" FontSize="11" />
            <TextBlock Text="{Binding EvidenceText}" TextWrapping="Wrap" Margin="0,0,0,10" />
            <Button Content="Exportar diagnóstico público" Command="{Binding ExportCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" />
            <TextBlock Text="{Binding ExportPath}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" />
            <Expander Header="Detalhes do probe sanitizado" IsExpanded="{Binding DetailsExpanded}" Foreground="{StaticResource TextBrush}">
              <TextBlock Text="{Binding ProbeDetails}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12" />
            </Expander>
          </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="Segurança" />
            <TextBlock Text="Usuário" Foreground="{StaticResource MutedBrush}" />
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" IsEnabled="{Binding IsAuthenticationMapped}" />
            <TextBlock Text="Senha" Foreground="{StaticResource MutedBrush}" />
            <PasswordBox x:Name="PasswordInput" PasswordChanged="OnPasswordChanged" Margin="0,4,0,8" IsEnabled="{Binding IsAuthenticationMapped}" />
            <CheckBox IsChecked="{Binding DoNotPersistCredential}" Content="Não persistir a credencial" Margin="0,0,0,8" IsEnabled="{Binding IsAuthenticationMapped}" />
            <Button Content="Login" Command="{Binding LoginCommand}" HorizontalAlignment="Left" Margin="0,0,0,12" IsEnabled="{Binding IsAuthenticationMapped}" />
            <TextBlock Text="{Binding AuthMessage}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
          </StackPanel>
        </Border>

        <Border Grid.Row="2" Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="Recomendações ao operador" />
            <TextBlock Text="{Binding Recommendations}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</Window>
