<Window x:Class="TantoOntManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tanto ONT Manager"
        Height="900"
        Width="1240"
        MinHeight="760"
        MinWidth="1040"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#161616" Padding="20,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding ProductName}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
          <TextBlock Text="Tanto Telecom · ferramenta interna de bancada" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="#2A2400" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,12,0">
            <TextBlock Text="{Binding ModeLabel}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
          </Border>
          <TextBlock Text="{Binding VersionLabel}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="#161616" Padding="20,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Última operação" Foreground="{StaticResource MutedBrush}" FontSize="11" />
          <TextBlock Text="{Binding LastOperation}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Text="Tempo" Foreground="{StaticResource MutedBrush}" FontSize="11" />
          <TextBlock Text="{Binding LastDuration}" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Log sanitizado" Foreground="{StaticResource MutedBrush}" FontSize="11" />
          <TextBlock Text="{Binding LogPath}" TextWrapping="Wrap" FontSize="11" />
        </StackPanel>
        <Border Grid.Column="3" Background="#2A2400" CornerRadius="4" Padding="12,8">
          <TextBlock Text="{Binding StatusLabel}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
        </Border>
      </Grid>
    </Border>

    <Grid Margin="20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="360" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitle}" Text="Conexão" />
              <TextBlock Text="Interface Ethernet" Foreground="{StaticResource MutedBrush}" />
              <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}" DisplayMemberPath="Name" Margin="0,4,0,10" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Estado do cabo" Foreground="{StaticResource MutedBrush}" />
                  <TextBlock Text="{Binding LinkState}" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="IPv4 atual" Foreground="{StaticResource MutedBrush}" />
                  <TextBlock Text="{Binding CurrentIpv4}" FontWeight="SemiBold" />
                </StackPanel>
              </Grid>
              <TextBlock Text="IP esperado da ONT" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" />
              <ComboBox ItemsSource="{Binding KnownIpOptions}" SelectedItem="{Binding SelectedKnownIp}" Margin="0,4,0,8" />
              <TextBox Text="{Binding CustomIp, UpdateSourceTrigger=PropertyChanged}"
                       Visibility="{Binding IsCustomIp, Converter={StaticResource BoolToVis}}"
                       Margin="0,0,0,8" />
              <TextBlock Text="{Binding ExpectedOntIp}" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12" />
              <CheckBox IsChecked="{Binding TrustLocalCertificate}" Content="Confiar no certificado HTTPS local somente deste IP" Margin="0,0,0,8" />
              <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,12"
                         Text="Aviso: o certificado da ONT é self-signed. A confiança não é global e vale só para o endereço selecionado." />
              <WrapPanel>
                <Button Content="Detectar ONT" Command="{Binding DetectCommand}" Margin="0,0,8,8" />
                <Button Content="Testar conexão" Command="{Binding TestConnectionCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
                <Button Content="Atualizar placas" Command="{Binding RefreshAdaptersCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" />
              </WrapPanel>
            </StackPanel>
          </Border>

          <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitle}" Text="Sessão" />
              <TextBlock Text="Usuário" Foreground="{StaticResource MutedBrush}" />
              <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" IsEnabled="{Binding IsAuthenticationMapped}" />
              <TextBlock Text="Senha" Foreground="{StaticResource MutedBrush}" />
              <PasswordBox x:Name="PasswordInput" PasswordChanged="OnPasswordChanged" Margin="0,4,0,8" IsEnabled="{Binding IsAuthenticationMapped}" />
              <CheckBox IsChecked="{Binding DoNotPersistCredential}" Content="Não persistir a credencial" Margin="0,0,0,8" IsEnabled="{Binding IsAuthenticationMapped}" />
              <TextBlock Text="{Binding AuthStateLabel}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6" />
              <TextBlock Text="{Binding SessionPhase}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10" />
              <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Login" Command="{Binding LoginCommand}" Margin="0,0,8,0" />
                <Button Content="Mapear leituras" Command="{Binding MapReadsCommand}" Margin="0,0,8,0" />
                <Button Content="Encerrar sessão" Command="{Binding EndSessionCommand}" Style="{StaticResource SecondaryButton}" />
              </StackPanel>
              <Button Content="Observar navegação GET" Command="{Binding ObserveNavigationCommand}" Margin="0,0,0,8" HorizontalAlignment="Left" />
              <TextBlock Text="{Binding AuthMessage}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <TabControl Grid.Column="2">
        <TabItem Header="Resumo">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <UniformGrid Columns="3" Margin="0,0,0,12">
                <StackPanel Margin="0,0,12,8">
                  <TextBlock Text="Fase" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                  <TextBlock Text="{Binding SessionPhase}" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Margin="0,0,12,8">
                  <TextBlock Text="Estado" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                  <TextBlock Text="{Binding AuthStateLabel}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                </StackPanel>
                <StackPanel Margin="0,0,0,8">
                  <TextBlock Text="Confiança pública" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                  <TextBlock Text="{Binding ConfidenceLabel}" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Margin="0,0,12,8">
                  <TextBlock Text="POST de login" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                  <TextBlock Text="{Binding LoginPostCount}" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Margin="0,0,12,8">
                  <TextBlock Text="POST de logout" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                  <TextBlock Text="{Binding LogoutPostCount}" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Margin="0,0,0,8">
                  <TextBlock Text="POST de configuração" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                  <TextBlock Text="{Binding ConfigPostCount}" FontWeight="Bold" />
                </StackPanel>
              </UniformGrid>
              <TextBlock Text="Detecção pública" Foreground="{StaticResource MutedBrush}" FontSize="11" />
              <TextBlock Text="{Binding EvidenceText}" TextWrapping="Wrap" Margin="0,0,0,12" />
              <TextBlock Text="Recomendações" Foreground="{StaticResource MutedBrush}" FontSize="11" />
              <TextBlock Text="{Binding Recommendations}" TextWrapping="Wrap" Margin="0,0,0,12" />
              <Expander Header="Detalhes do probe sanitizado" IsExpanded="{Binding DetailsExpanded}" Foreground="{StaticResource TextBrush}">
                <TextBlock Text="{Binding ProbeDetails}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12" />
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Dispositivo">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <UniformGrid Columns="2">
              <StackPanel Margin="0,0,16,12">
                <TextBlock Text="Fabricante" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                <TextBlock Text="{Binding Manufacturer}" FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel Margin="0,0,0,12">
                <TextBlock Text="Device Type" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                <TextBlock Text="{Binding Model}" FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel Margin="0,0,16,12">
                <TextBlock Text="Hardware Version" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                <TextBlock Text="{Binding Hardware}" />
              </StackPanel>
              <StackPanel Margin="0,0,0,12">
                <TextBlock Text="Software Version" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                <TextBlock Text="{Binding Firmware}" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Margin="0,0,16,12">
                <TextBlock Text="Boot Version" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                <TextBlock Text="{Binding Boot}" />
              </StackPanel>
              <StackPanel Margin="0,0,0,12">
                <TextBlock Text="Serial (mascarado)" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                <TextBlock Text="{Binding Serial}" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Margin="0,0,16,12">
                <TextBlock Text="MAC (mascarado)" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                <TextBlock Text="{Binding Mac}" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Margin="0,0,0,12">
                <TextBlock Text="Título público" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                <TextBlock Text="{Binding PublicTitle}" TextWrapping="Wrap" />
              </StackPanel>
            </UniformGrid>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="PON">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <UniformGrid Columns="2">
              <StackPanel Margin="0,0,16,12">
                <TextBlock Text="ONU State" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                <TextBlock Text="{Binding Pon}" FontWeight="SemiBold" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Margin="0,0,0,12">
                <TextBlock Text="Temperature" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                <TextBlock Text="{Binding Temperature}" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Margin="0,0,16,12">
                <TextBlock Text="Input Power" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                <TextBlock Text="{Binding InputPower}" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Margin="0,0,0,12">
                <TextBlock Text="Output Power" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                <TextBlock Text="{Binding OutputPower}" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Margin="0,0,16,12">
                <TextBlock Text="Supply Voltage" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                <TextBlock Text="{Binding Voltage}" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Margin="0,0,0,12">
                <TextBlock Text="Transmitter Bias Current" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                <TextBlock Text="{Binding BiasCurrent}" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Margin="0,0,16,12">
                <TextBlock Text="LOID" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                <TextBlock Text="{Binding Loid}" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Margin="0,0,0,12">
                <TextBlock Text="GPON SN (mascarado)" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                <TextBlock Text="{Binding GponSerial}" TextWrapping="Wrap" />
              </StackPanel>
            </UniformGrid>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="WAN">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="Perfis WAN (somente leitura, IP e MAC mascarados, sem senha PPPoE)" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,8" />
              <TextBlock Text="{Binding WanProfiles}" TextWrapping="Wrap" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Diagnóstico">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="Capacidades" Foreground="{StaticResource MutedBrush}" FontSize="11" />
              <TextBlock Text="{Binding Capabilities}" TextWrapping="Wrap" Margin="0,0,0,12" />
              <Button Content="Exportar diagnóstico público" Command="{Binding ExportCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" />
              <Button Content="Exportar diagnóstico autenticado" Command="{Binding ExportAuthenticatedCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" />
              <Button Content="Exportar mapa sanitizado" Command="{Binding ExportReadMapCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" />
              <Button Content="Exportar observação sanitizada" Command="{Binding ExportObservationCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" />
              <Button Content="Promover contrato de leitura" Command="{Binding PromoteContractCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" />
              <Button Content="Promover contrato de gravação" Command="{Binding PromoteWriteContractCommand}" HorizontalAlignment="Left" Margin="0,0,0,12" />
              <TextBlock Text="{Binding ExportPath}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" />
              <TextBlock Text="Inspeção do ZIP autenticado" Foreground="{StaticResource MutedBrush}" FontSize="11" />
              <TextBlock Text="{Binding ZipInspection}" TextWrapping="Wrap" Margin="0,0,0,12" FontFamily="Consolas" />
              <TextBlock Text="GET homologados (sanitizado)" Foreground="{StaticResource MutedBrush}" FontSize="11" />
              <TextBlock Text="{Binding DiagnosticGetsText}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Margin="0,0,0,12" />
              <TextBlock Text="Inventário SafeRead" Foreground="{StaticResource MutedBrush}" FontSize="11" />
              <TextBlock Text="{Binding InventoryText}" TextWrapping="Wrap" FontSize="12" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Observação">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="Contadores do observador GET" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,8" />
              <TextBlock Text="{Binding ObservationCounters}" FontFamily="Consolas" Margin="0,0,0,12" />
              <TextBlock Text="Tabela sanitizada (Tela | GET | classificação)" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,8" />
              <TextBlock Text="{Binding ObservationText}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Mapa">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="Mapear leituras autenticadas — somente GET, sem inventar tags" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,8" />
              <TextBlock Text="{Binding ReadMapText}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</Window>
